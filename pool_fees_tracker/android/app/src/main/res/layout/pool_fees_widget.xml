<?xml version="1.0" encoding="utf-8"?>
<!-- Pedido do utilizador: só mostrava UM número — o espaço dá para mais.
     Mostra agora o metric escolhido (Definições → widget) em destaque,
     mais os outros dois, mais pequenos, numa linha por baixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8A8F98"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        tools:text="TOTAL DE TAXAS GERADAS" />

    <TextView
        android:id="@+id/widget_total_fees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#F2F3F5"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="$12,847.32" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_secondary1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5B6168"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                tools:text="TAXAS 24H" />

            <TextView
                android:id="@+id/widget_secondary1_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C7CAD1"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="$42.10" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_secondary2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5B6168"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                tools:text="NÃO RECLAMADAS" />

            <TextView
                android:id="@+id/widget_secondary2_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C7CAD1"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="$310.55" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#5B6168"
        android:textSize="10sp"
        tools:text="Atualizado há 2m" />
</LinearLayout>
